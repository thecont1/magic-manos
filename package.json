{
  "name": "magic-manos",
  "private": true,
  "version": "0.0.0",
  "description": "One-click filters, applied honestly to honest pixels.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.lab.json",
